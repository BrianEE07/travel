---
import type { FoodEntity } from '../../types';
import TagChips from './TagChips.astro';
interface Props { entity: FoodEntity; }
const { entity } = Astro.props;
const reservation = entity.reservation
  ? ({ done: '已訂位', none: '免訂位', needed: '需訂位', tbd: '待確認' }[entity.reservation.text] ?? entity.reservation.text)
  : '';
---
<button class="entity-card entity-food" type="button" data-entity={entity.id} data-type="food">
  <span class="entity-type">餐飲</span>
  <strong>{entity.title}</strong>
  <span class="entity-summary">{entity.summary.text}</span>
  <TagChips type="food" tags={entity.tags} />
  <span class="entity-card-facts">
    <span class="entity-fact"><i>區域</i><b>{entity.area.text}</b></span>
    {reservation && <span class="entity-fact"><i>訂位</i><b>{reservation}</b></span>}
  </span>
  <span class="entity-open">查看餐飲資訊 <i class="external-arrow" aria-hidden="true"></i></span>
</button>
