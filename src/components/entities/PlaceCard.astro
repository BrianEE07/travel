---
import type { PlaceEntity } from '../../types';
interface Props { entity: PlaceEntity; }
const { entity } = Astro.props;
---
<button class="entity-card entity-place" type="button" data-entity={entity.id} data-type="place">
  <span class="entity-type">景點</span>
  <strong>{entity.title}</strong>
  <span class="entity-summary">{entity.summary.text}</span>
  <span class="entity-card-facts">
    <span class="entity-fact"><i>適合</i><b>{entity.bestFor.text}</b></span>
    <span class="entity-fact"><i>區域</i><b>{entity.area.text}</b></span>
  </span>
  <span class="entity-open">查看景點資訊 <i class="external-arrow" aria-hidden="true"></i></span>
</button>
