---
import BaseLayout from '../layouts/BaseLayout.astro';
import Brand from './Brand.astro';
import ServiceWorkerUpdate from './ServiceWorkerUpdate.astro';
import StayCard from './entities/StayCard.astro';
import FoodCard from './entities/FoodCard.astro';
import PlaceCard from './entities/PlaceCard.astro';
import TransportCard from './entities/TransportCard.astro';
import '../styles/trip.css';
import type { Trip } from '../types';

interface Props { trip: Trip; }
const { trip } = Astro.props;

const formatDate = (date: string, includeYear = false) => {
  if (!date) return '';
  const value = new Date(`${date}T12:00:00+08:00`);
  return new Intl.DateTimeFormat('zh-TW', {
    ...(includeYear ? { year: 'numeric' as const } : {}),
    month: 'long',
    day: 'numeric',
  }).format(value);
};
const weekday = (date: string) => new Intl.DateTimeFormat('zh-TW', { weekday: 'short' }).format(new Date(`${date}T12:00:00+08:00`));
const updated = new Intl.DateTimeFormat('zh-TW', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', hourCycle: 'h23', timeZone: 'Asia/Taipei' }).format(new Date(trip.updatedAt));
const entityTypeLabel: Record<string, string> = { stay: '住宿', food: '餐飲', place: '景點', transport: '交通' };
const timelineKindLabel: Record<string, string> = { move: '移動', food: '餐飲', place: '景點', shopping: '逛街', activity: '活動', rest: '休息', buffer: '緩衝' };
const entityJson = JSON.stringify(trip.entities).replaceAll('<', '\\u003c');
const description = `${trip.summary} ${formatDate(trip.start, true)}至${formatDate(trip.end)}。`;
const hasPlanningDays = trip.days.some((day) => !day.detailed);
---

<BaseLayout title={`${trip.title}｜Wei 的旅行手帖`} description={description} noindex={trip.noindex} image={trip.coverImage}>
  <header class="site-header">
    <Brand />
    <div class="header-meta">
      <span class="updated-at">更新於 {updated}</span>
    </div>
  </header>

  <main>
    <section class="hero" aria-labelledby="trip-title">
      <img src={trip.coverImage} alt={trip.coverAlt} width="1693" height="929" fetchpriority="high" />
      <div class="hero-overlay"></div>
      <div class="hero-copy">
        <p class="eyebrow">{trip.kicker}</p>
        <div class="hero-title-row">
          <h1 id="trip-title">{trip.title}</h1>
          <button id="copy-trip-link" class="share-link" type="button" aria-label="複製行程連結" title="複製行程連結" data-feedback="">
            <span class="link-symbol" aria-hidden="true"></span>
            <span class="share-live" aria-live="polite"></span>
          </button>
        </div>
        <p class="date-range">{formatDate(trip.start, true)} — {formatDate(trip.end, true)}</p>
        <p class="locations">{trip.locations.join(' · ')}</p>
        <a class="hero-cta" href={`#day-${trip.days[0]?.date}`}>
          開始看行程 <span aria-hidden="true">↓</span>
        </a>
      </div>
      <div class="hero-stamp" aria-hidden="true">
        <span>{trip.code}</span>
        <small>{trip.start.slice(0, 4)}</small>
      </div>
    </section>

    <nav class="day-nav" aria-label="日期快速導覽">
      <div class="day-nav-shell">
        <a class="nav-shortcut day-nav-home" href="/" aria-label="回到旅行手帖首頁">
          <span aria-hidden="true">旅</span>
          <small>首頁</small>
        </a>
        <div class="day-nav-route">
          <a class="nav-shortcut desktop-nav-shortcut" href="#trip-overview">
            <span aria-hidden="true">覽</span>
            <small>總覽</small>
          </a>
          <div class="day-nav-scroll">
            <div class="day-nav-days">
              {trip.days.map((day, index) => (
                <a
                  href={`#day-${day.date}`}
                  data-day={day.date}
                  aria-current={index === 0 ? 'step' : undefined}
                  class:list={['day-nav-date', index === 0 && 'is-current', day.detailed ? 'is-complete' : 'is-planning']}
                >
                  <span>{formatDate(day.date)}</span>
                  <small>{weekday(day.date)}</small>
                </a>
              ))}
            </div>
          </div>
          <a class="nav-shortcut desktop-nav-shortcut" href="#detail-library" data-open-database>
            <span aria-hidden="true">冊</span>
            <small>資料</small>
          </a>
        </div>
        <button class="nav-shortcut desktop-nav-top" type="button" data-scroll-top aria-label="回到最上方">
          <span aria-hidden="true">⌃</span>
          <small>頂端</small>
        </button>
        <button id="quick-nav-toggle" class="nav-shortcut mobile-nav-toggle" type="button" aria-expanded="false" aria-controls="quick-nav-menu">
          <span aria-hidden="true">目</span>
          <small>目錄</small>
        </button>
        <div id="quick-nav-menu" class="mobile-nav-menu" hidden>
          <a href="#trip-overview"><span aria-hidden="true">覽</span><small>旅程總覽</small></a>
          <a href="#detail-library" data-open-database><span aria-hidden="true">冊</span><small>旅行資料庫</small></a>
          <button type="button" data-scroll-top><span aria-hidden="true">⌃</span><small>回到最上方</small></button>
        </div>
      </div>
    </nav>

    <section class="intro-grid" aria-label="旅程摘要">
      <div>
        <p class="section-kicker">The route</p>
        <h2>{trip.summary}</h2>
      </div>
      <div class="intro-copy">
        <p>{trip.intro}</p>
        <div class="legend" aria-label="圖例">
          <span><i class="dot dot-plan"></i> 完整行程</span>
          {hasPlanningDays && <span><i class="dot dot-draft"></i> 規劃中</span>}
        </div>
      </div>
    </section>

    <section id="trip-overview" class="trip-briefing" aria-labelledby="briefing-heading">
      <img class="briefing-art" src={trip.briefingImage} alt="" width="1693" height="929" loading="lazy" decoding="async" />
      <div class="briefing-heading">
        <div>
          <p class="section-kicker">Travel briefing</p>
          <h2 id="briefing-heading">旅程總覽</h2>
        </div>
        <p>{trip.overview.status}</p>
      </div>
      <div class="briefing-grid">
        <dl class="briefing-facts">
          <div><dt>日期</dt><dd>{trip.overview.date}</dd></div>
          <div><dt>地點</dt><dd>{trip.overview.places.join('、')}</dd></div>
          <div><dt>同行</dt><dd>{trip.overview.people}</dd></div>
        </dl>
        <div class="briefing-routes">
          <section>
            <h3>主要交通</h3>
            <ul>{trip.overview.transports.map((item) => <li set:html={item.html}></li>)}</ul>
          </section>
          <section>
            <h3>住宿安排</h3>
            <ul>{trip.overview.stays.map((item) => <li set:html={item.html}></li>)}</ul>
          </section>
        </div>
      </div>
    </section>

    <section class="days" aria-labelledby="days-heading">
      <div class="section-heading">
        <p class="section-kicker">Daily itinerary</p>
        <h2 id="days-heading">每日細流</h2>
      </div>

      {trip.days.map((day, index) => (
        <article id={`day-${day.date}`} class:list={['day-card', !day.detailed && 'day-card-planning']}>
          <div class="day-date">
            <span class="day-number">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <time datetime={day.date}>{formatDate(day.date)}</time>
              <p>{weekday(day.date)} · {day.area}</p>
            </div>
            {!day.detailed && <span class="planning-badge">規劃中</span>}
          </div>

          {day.detailed ? (
            <div class="day-content">
              <ol class="timeline">
                {day.timeline.map((item) => (
                  <li>
                    <div class="timeline-time">
                      <time>{item.time || '彈性'}</time>
                    </div>
                    <div class="timeline-body">
                      <span class={`timeline-kind kind-${item.kind}`}>{timelineKindLabel[item.kind]}</span>
                      <div set:html={item.textHtml}></div>
                    </div>
                  </li>
                ))}
              </ol>
              <aside class="day-aside">
                <div class="stay-card">
                  <span>Stay</span>
                  {day.stayEntityId ? (
                    <button class="inline-detail stay-link" type="button" data-entity={day.stayEntityId}>{day.stay}</button>
                  ) : (
                    <strong>{day.stay}</strong>
                  )}
                </div>
                {day.notes.length > 0 && (
                  <div class="notes-card">
                    <span>Travel notes</span>
                    <ul>
                      {day.notes.map((note) => <li set:html={note.html}></li>)}
                    </ul>
                  </div>
                )}
              </aside>
            </div>
          ) : (
            <div class="planning-summary">
              <div>
                <span>已確定</span>
                <p>{day.summary || day.itineraryNote || '日期與住宿已保留，細節會隨筆記更新。'}</p>
              </div>
              <div>
                <span>Stay</span>
                {day.stayEntityId ? (
                  <button class="inline-detail stay-link" type="button" data-entity={day.stayEntityId}>{day.stay}</button>
                ) : (
                  <p>{day.stay}</p>
                )}
              </div>
              {day.notes.length > 0 && (
                <div class="planning-notes">
                  <span>目前想法</span>
                  <ul>{day.notes.map((note) => <li set:html={note.html}></li>)}</ul>
                </div>
              )}
            </div>
          )}
        </article>
      ))}
    </section>

    <section id="detail-library" class="detail-library is-collapsed" aria-labelledby="details-heading">
      <div class="section-heading detail-heading">
        <div>
          <p class="section-kicker">Quick reference</p>
          <h2 id="details-heading">旅行資料庫</h2>
        </div>
        <div class="detail-controls">
          <button id="database-toggle" class="database-toggle" type="button" aria-expanded="false" aria-controls="database-grid">
            <span>展開資料</span><i aria-hidden="true">＋</i>
          </button>
          <div class="filter-tabs" role="group" aria-label="篩選資訊">
            <button type="button" class="is-active" data-filter="all">全部</button>
            {Object.entries(entityTypeLabel).map(([type, label]) => <button type="button" data-filter={type}>{label}</button>)}
          </div>
        </div>
      </div>
      <div id="database-grid" class="entity-grid">
        {trip.entities.map((entity) => (
          entity.type === 'stay' ? <StayCard entity={entity} />
          : entity.type === 'food' ? <FoodCard entity={entity} />
          : entity.type === 'place' ? <PlaceCard entity={entity} />
          : <TransportCard entity={entity} />
        ))}
      </div>
    </section>
  </main>

  <footer>
    <p>旅程會繼續更新，出發前記得重新整理一次。</p>
  </footer>

  <dialog id="detail-dialog" aria-labelledby="dialog-title">
    <div class="dialog-shell">
      <button class="dialog-close" type="button" aria-label="關閉資訊視窗">×</button>
      <div class="dialog-visual" aria-hidden="true">
        <span class="dialog-type"></span>
        <div class="dialog-pattern"></div>
      </div>
      <div class="dialog-content">
        <img id="dialog-preview" class="dialog-preview" alt="" hidden />
        <p class="section-kicker dialog-kicker">Quick reference</p>
        <h2 id="dialog-title"></h2>
        <div id="dialog-summary" class="dialog-summary"></div>
        <div id="dialog-segments" class="dialog-segment-tabs" role="tablist" aria-label="交通分段" hidden></div>
        <div id="dialog-details" class="dialog-details" role="tabpanel"></div>
        <div id="dialog-actions" class="dialog-actions"></div>
        <p class="dialog-hint">點選視窗外、按 Esc 或瀏覽器返回鍵即可回到行程。</p>
      </div>
    </div>
  </dialog>

  <ServiceWorkerUpdate />

  <script id="entity-data" type="application/json" is:inline set:html={entityJson}></script>
  <script>
    const dialog = document.querySelector<HTMLDialogElement>('#detail-dialog');
    const entityData = document.querySelector<HTMLScriptElement>('#entity-data');
    const entities = entityData ? JSON.parse(entityData.textContent || '[]') : [];
    const entityMap = new Map(entities.map((entity: any) => [entity.id, entity]));
    const typeLabels: Record<string, string> = { stay: '住宿', food: '餐飲', place: '景點', transport: '交通' };
    const detailFields: Record<string, Array<[string, string]>> = {
      stay: [['area', '區域'], ['checkIn', '入住'], ['checkOut', '退房'], ['room', '房型'], ['price', '價格'], ['access', '交通'], ['contact', '聯絡'], ['policy', '取消政策']],
      food: [['area', '區域'], ['hours', '營業'], ['reservation', '訂位'], ['reservationTime', '時間'], ['party', '人數'], ['why', '安排原因'], ['risk', '留意'], ['backup', '備案']],
      place: [['area', '區域'], ['hours', '開放'], ['why', '安排原因'], ['bestFor', '適合'], ['nearby', '附近'], ['risk', '留意']],
    };
    const transportSegmentFields: Array<[string, string]> = [
      ['route', '路線'],
      ['time', '時間'],
      ['plan', '現場行動'],
      ['operator', '營運'],
      ['price', '價格'],
      ['note', '備註'],
    ];
    const reservationLabels: Record<string, string> = { done: '已完成', none: '免訂位', needed: '需要訂位', tbd: '待確認' };
    const shareButton = document.querySelector<HTMLButtonElement>('#copy-trip-link');
    const quickNavToggle = document.querySelector<HTMLButtonElement>('#quick-nav-toggle');
    const quickNavMenu = document.querySelector<HTMLElement>('#quick-nav-menu');
    const databaseSection = document.querySelector<HTMLElement>('#detail-library');
    const databaseToggle = document.querySelector<HTMLButtonElement>('#database-toggle');
    const dayNav = document.querySelector<HTMLElement>('.day-nav');
    const dayNavScroll = document.querySelector<HTMLElement>('.day-nav-scroll');
    const dayLinks = [...document.querySelectorAll<HTMLAnchorElement>('.day-nav-date[data-day]')];
    const dayCards = [...document.querySelectorAll<HTMLElement>('.day-card[id^="day-"]')];
    let dialogReturnScrollY = 0;
    let previousScrollRestoration: ScrollRestoration = 'auto';
    let activeDay = dayLinks[0]?.dataset.day || '';
    let scrollFrame = 0;
    let pendingNavigationDay = '';
    let navigationSettleTimer = 0;

    function scrollToTop() {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
    }

    document.querySelectorAll<HTMLElement>('[data-scroll-top]').forEach((button) => button.addEventListener('click', () => {
      closeQuickNav();
      scrollToTop();
    }));

    function closeQuickNav() {
      if (!quickNavMenu || !quickNavToggle) return;
      quickNavMenu.hidden = true;
      quickNavToggle.setAttribute('aria-expanded', 'false');
    }

    function setDatabaseExpanded(expanded: boolean) {
      if (!databaseSection || !databaseToggle) return;
      databaseSection.classList.toggle('is-collapsed', !expanded);
      databaseToggle.setAttribute('aria-expanded', String(expanded));
      const label = databaseToggle.querySelector('span');
      const icon = databaseToggle.querySelector('i');
      if (label) label.textContent = expanded ? '收合資料' : '展開資料';
      if (icon) icon.textContent = expanded ? '−' : '＋';
    }

    databaseToggle?.addEventListener('click', () => setDatabaseExpanded(databaseSection?.classList.contains('is-collapsed') ?? true));
    document.querySelectorAll<HTMLElement>('[data-open-database]').forEach((link) => link.addEventListener('click', () => setDatabaseExpanded(true)));

    function centerDayLink(link: HTMLAnchorElement, smooth = true) {
      if (!dayNavScroll) return;
      const left = link.offsetLeft + link.offsetWidth / 2 - dayNavScroll.clientWidth / 2;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      dayNavScroll.scrollTo({ left: Math.max(0, left), behavior: smooth && !reduceMotion ? 'smooth' : 'auto' });
    }

    function setActiveDay(date: string, smooth = true) {
      if (!date) return;
      const changed = date !== activeDay;
      activeDay = date;
      let current: HTMLAnchorElement | undefined;
      for (const link of dayLinks) {
        const selected = link.dataset.day === date;
        link.classList.toggle('is-current', selected);
        if (selected) {
          link.setAttribute('aria-current', 'step');
          current = link;
        } else {
          link.removeAttribute('aria-current');
        }
      }
      const focusedDay = document.activeElement instanceof HTMLAnchorElement && document.activeElement.matches('.day-nav-date')
        ? document.activeElement
        : null;
      if (focusedDay && focusedDay.dataset.day !== date) focusedDay.blur();
      if (current && changed) centerDayLink(current, smooth);
    }

    function updateActiveDay() {
      scrollFrame = 0;
      if (!dayCards.length || pendingNavigationDay) return;
      const threshold = (dayNav?.offsetHeight || 0) + Math.min(190, window.innerHeight * .26);
      let current = dayCards[0];
      for (const card of dayCards) {
        if (card.getBoundingClientRect().top <= threshold) current = card;
        else break;
      }
      setActiveDay(current.id.replace(/^day-/, ''));
    }

    function finishDayNavigation() {
      window.clearTimeout(navigationSettleTimer);
      navigationSettleTimer = 0;
      pendingNavigationDay = '';
      updateActiveDay();
    }

    function scheduleDayNavigationFinish(delay = 160) {
      window.clearTimeout(navigationSettleTimer);
      navigationSettleTimer = window.setTimeout(finishDayNavigation, delay);
    }

    dayLinks.forEach((link) => link.addEventListener('click', () => {
      pendingNavigationDay = link.dataset.day || '';
      setActiveDay(pendingNavigationDay);
      scheduleDayNavigationFinish(1200);
    }));
    window.addEventListener('scroll', () => {
      if (pendingNavigationDay) {
        scheduleDayNavigationFinish();
        return;
      }
      if (!scrollFrame) scrollFrame = window.requestAnimationFrame(updateActiveDay);
    }, { passive: true });

    quickNavToggle?.addEventListener('click', () => {
      if (!quickNavMenu) return;
      const opening = quickNavMenu.hidden;
      quickNavMenu.hidden = !opening;
      quickNavToggle.setAttribute('aria-expanded', String(opening));
    });
    quickNavMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeQuickNav));
    document.addEventListener('click', (event) => {
      const target = event.target as Node;
      if (!quickNavMenu?.hidden && !quickNavMenu?.contains(target) && !quickNavToggle?.contains(target)) closeQuickNav();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !quickNavMenu?.hidden) {
        closeQuickNav();
        quickNavToggle?.focus();
      }
    });
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1180) closeQuickNav();
      const current = dayLinks.find((link) => link.dataset.day === activeDay);
      if (current) centerDayLink(current, false);
    }, { passive: true });
    window.requestAnimationFrame(updateActiveDay);

    async function copyTripLink() {
      if (!shareButton) return;
      const cleanUrl = new URL(window.location.href);
      cleanUrl.hash = '';
      cleanUrl.search = '';
      let copied = false;
      try {
        await navigator.clipboard.writeText(cleanUrl.href);
        copied = true;
      } catch {
        const field = document.createElement('textarea');
        field.value = cleanUrl.href;
        field.setAttribute('readonly', '');
        field.style.position = 'fixed';
        field.style.opacity = '0';
        document.body.append(field);
        field.select();
        const legacyDocument = document as unknown as { execCommand: (command: string) => boolean };
        copied = legacyDocument.execCommand('copy');
        field.remove();
      }
      const feedback = copied ? '已複製' : '請再試一次';
      shareButton.dataset.feedback = feedback;
      shareButton.classList.toggle('is-copied', copied);
      const live = shareButton.querySelector<HTMLElement>('.share-live');
      if (live) live.textContent = feedback;
      window.setTimeout(() => {
        shareButton.classList.remove('is-copied');
        shareButton.dataset.feedback = '';
        if (live) live.textContent = '';
      }, 1800);
    }

    shareButton?.addEventListener('click', copyTripLink);

    function fillDialog(entity: any, requestedSegmentId = '') {
      if (!dialog) return;
      const title = dialog.querySelector<HTMLElement>('#dialog-title');
      const type = dialog.querySelector<HTMLElement>('.dialog-type');
      const summary = dialog.querySelector<HTMLElement>('#dialog-summary');
      const segmentTabs = dialog.querySelector<HTMLElement>('#dialog-segments');
      const details = dialog.querySelector<HTMLElement>('#dialog-details');
      const actions = dialog.querySelector<HTMLElement>('#dialog-actions');
      const preview = dialog.querySelector<HTMLImageElement>('#dialog-preview');
      if (title) title.textContent = entity.title;
      if (type) type.textContent = typeLabels[entity.type] || entity.type;
      if (summary) summary.innerHTML = entity.summary?.html || '';
      const escapeDialogText = (text: string) => text
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
      const renderTransportField = (key: string, value: any) => {
        if (key === 'time') return `<div class="transport-time-list"><span>${escapeDialogText(value.text)}</span></div>`;
        if (key === 'route') {
          const nodes = value.text.replace(/[。.]$/, '').split('→').map((node: string) => node.trim()).filter(Boolean);
          return `<div class="transport-route-line">${nodes.map((node: string, index: number) => `${index ? '<i aria-hidden="true">→</i>' : ''}<span>${escapeDialogText(node)}</span>`).join('')}</div>`;
        }
        return value.html;
      };
      const renderDetails = (source: any, fields: Array<[string, string]>, transport = false) => {
        if (!details) return;
        details.classList.toggle('is-transport', transport);
        details.innerHTML = fields.map(([key, label]) => {
          const value = source[key];
          if (!value) return '';
          const html = transport
            ? renderTransportField(key, value)
            : key === 'reservation' ? (reservationLabels[value.text] || value.html) : value.html;
          const rowClass = transport ? ` dialog-row-${key}` : '';
          return `<div class="dialog-row${rowClass}"><span>${label}</span><div>${html}</div></div>`;
        }).join('');
      };
      const renderActions = (dialogActions: any[]) => {
        if (!actions) return;
        actions.innerHTML = dialogActions.map((action: any) => `
          <a href="${action.url}" target="_blank" rel="noopener noreferrer">
            ${action.label}<i class="external-arrow" aria-hidden="true"></i>
          </a>`).join('');
      };

      if (entity.type === 'transport') {
        const segments = entity.segments || [];
        const selected = segments.find((segment: any) => segment.id === requestedSegmentId) || segments[0];
        const selectSegment = (segment: any, updateHistory = false) => {
          if (!segment) return;
          renderDetails(segment, transportSegmentFields, true);
          renderActions(segment.official ? [segment.official] : []);
          dialog.dataset.segment = segment.id;
          segmentTabs?.querySelectorAll<HTMLButtonElement>('[data-dialog-segment]').forEach((button) => {
            const active = button.dataset.dialogSegment === segment.id;
            button.classList.toggle('is-active', active);
            button.setAttribute('aria-selected', String(active));
            button.tabIndex = active ? 0 : -1;
            if (active && details) details.setAttribute('aria-labelledby', button.id);
          });
          if (updateHistory && history.state?.dialogEntry) {
            history.replaceState({ ...history.state, segment: segment.id }, '', location.href);
          }
        };
        if (segmentTabs) {
          segmentTabs.hidden = segments.length <= 1;
          if (segments.length <= 1) details?.removeAttribute('aria-labelledby');
          segmentTabs.innerHTML = segments.length > 1 ? segments.map((segment: any, index: number) => `
            <button id="dialog-segment-${index}" type="button" role="tab" data-dialog-segment="${escapeDialogText(segment.id)}" aria-controls="dialog-details">
              ${escapeDialogText(segment.label)}
            </button>`).join('') : '';
          const buttons = [...segmentTabs.querySelectorAll<HTMLButtonElement>('[data-dialog-segment]')];
          buttons.forEach((button, index) => {
            button.addEventListener('click', () => selectSegment(segments[index], true));
            button.addEventListener('keydown', (event) => {
              if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
              event.preventDefault();
              const direction = event.key === 'ArrowRight' ? 1 : -1;
              const nextIndex = (index + direction + buttons.length) % buttons.length;
              selectSegment(segments[nextIndex], true);
              buttons[nextIndex].focus();
            });
          });
        }
        selectSegment(selected);
      } else {
        if (segmentTabs) {
          segmentTabs.hidden = true;
          segmentTabs.innerHTML = '';
        }
        details?.removeAttribute('aria-labelledby');
        delete dialog.dataset.segment;
        renderDetails(entity, detailFields[entity.type] || []);
        renderActions(entity.actions || []);
      }
      if (preview) {
        const image = entity.preview?.image;
        preview.hidden = !image;
        preview.src = image || '';
        preview.alt = image ? `${entity.title} 網站預覽` : '';
        preview.onerror = () => { preview.hidden = true; };
      }
      dialog.dataset.type = entity.type;
    }

    function lockPageScroll(returnScrollY = window.scrollY) {
      dialogReturnScrollY = returnScrollY;
      const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
      previousScrollRestoration = history.scrollRestoration;
      history.scrollRestoration = 'manual';
      document.body.style.paddingRight = scrollbarWidth > 0 ? `${scrollbarWidth}px` : '';
      document.documentElement.classList.add('dialog-open');
      document.body.classList.add('dialog-open');
    }

    function unlockPageScroll(returnScrollY = dialogReturnScrollY) {
      const root = document.documentElement;
      const previousInlineScrollBehavior = root.style.scrollBehavior;
      root.style.scrollBehavior = 'auto';
      root.classList.remove('dialog-open');
      document.body.classList.remove('dialog-open');
      document.body.style.removeProperty('padding-right');
      if (Math.abs(window.scrollY - returnScrollY) > 1) {
        window.scrollTo({ top: returnScrollY, left: 0, behavior: 'auto' });
      }
      requestAnimationFrame(() => {
        root.style.scrollBehavior = previousInlineScrollBehavior;
        history.scrollRestoration = previousScrollRestoration;
      });
    }

    function finishDialogClose(returnScrollY = dialogReturnScrollY) {
      if (dialog?.open) dialog.close();
      unlockPageScroll(returnScrollY);
    }

    function openEntity(id: string, segmentId = '', push = true, returnScrollY?: number) {
      const entity = entityMap.get(id);
      if (!entity || !dialog) return;
      fillDialog(entity, segmentId);
      if (!dialog.open) {
        lockPageScroll(returnScrollY);
        dialog.showModal();
      }
      if (push) {
        history.replaceState({ ...history.state, tripScrollY: dialogReturnScrollY }, '', location.href);
        history.pushState({ detail: id, segment: dialog.dataset.segment || '', dialogEntry: true, tripScrollY: dialogReturnScrollY }, '', location.href);
      }
    }

    function closeDialog(useHistory = true) {
      if (!dialog?.open) return;
      if (useHistory && history.state?.dialogEntry) {
        history.back();
      } else {
        if (location.hash.startsWith('#detail=')) {
          history.replaceState(null, '', `${location.pathname}${location.search}`);
        }
        finishDialogClose();
      }
    }

    document.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-entity]');
      if (trigger?.dataset.entity) openEntity(trigger.dataset.entity, trigger.dataset.segment || '');
    });
    dialog?.querySelector('.dialog-close')?.addEventListener('click', () => closeDialog());
    dialog?.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeDialog();
    });
    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) closeDialog();
    });
    window.addEventListener('popstate', (event) => {
      const legacyDetail = location.hash.startsWith('#detail=') ? decodeURIComponent(location.hash.slice(8)) : '';
      const id = event.state?.dialogEntry ? event.state.detail : legacyDetail;
      const returnScrollY = Number.isFinite(event.state?.tripScrollY) ? event.state.tripScrollY : dialogReturnScrollY;
      if (id) openEntity(id, event.state?.segment || '', false, returnScrollY);
      else if (dialog?.open) finishDialogClose(returnScrollY);
    });
    const initialDetail = location.hash.startsWith('#detail=') ? decodeURIComponent(location.hash.slice(8)) : '';
    if (initialDetail) openEntity(initialDetail, '', false);

    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter;
        document.querySelectorAll('[data-filter]').forEach((item) => item.classList.toggle('is-active', item === button));
        document.querySelectorAll<HTMLElement>('.entity-card').forEach((card) => {
          card.hidden = filter !== 'all' && card.dataset.type !== filter;
        });
      });
    });

  </script>
</BaseLayout>
