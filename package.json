{
  "name": "wei-travel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-trip.mjs",
    "sync:previews": "node scripts/sync-trip.mjs --fetch-previews",
    "dev": "npm run sync && astro dev",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run sync && npm run test && ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/scan-dist.mjs",
    "preview": "astro preview",
    "publish": "node scripts/publish.mjs"
  },
  "dependencies": {
    "astro": "7.1.6",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
